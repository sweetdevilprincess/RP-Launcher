from __future__ import annotations

import json
from pathlib import Path
from typing import Any, Dict, List, Optional

import pytest

from refactoring.src.automation.factory import build_file_access_service
from refactoring.src.infrastructure.filesystem.write_queue import FileWriteQueue
from refactoring.src.shared.interfaces import LoggingService


class StubLogger(LoggingService):
    def debug(self, message: str, *, context: Optional[Dict[str, Any]] = None) -> None:
        pass

    def info(self, message: str, *, context: Optional[Dict[str, Any]] = None) -> None:
        pass

    def warning(self, message: str, *, context: Optional[Dict[str, Any]] = None) -> None:
        pass

    def error(self, message: str, *, context: Optional[Dict[str, Any]] = None) -> None:
        pass

    def exception(
        self,
        message: str,
        *,
        context: Optional[Dict[str, Any]] = None,
        exc: Optional[BaseException] = None,
    ) -> None:
        pass


class StubQueue:
    def __init__(self) -> None:
        self.text_writes: List[Path] = []
        self.json_writes: Dict[Path, Any] = {}
        self.flushed = False
        self.shutdown_called = False

    def write_text(self, file_path: Path, content: str, encoding: str = "utf-8") -> None:
        file_path.parent.mkdir(parents=True, exist_ok=True)
        file_path.write_text(content, encoding=encoding)
        self.text_writes.append(file_path)

    def write_json(
        self,
        file_path: Path,
        data: Any,
        encoding: str = "utf-8",
        indent: int = 2,
    ) -> None:
        file_path.parent.mkdir(parents=True, exist_ok=True)
        file_path.write_text(json.dumps(data, indent=indent), encoding=encoding)
        self.json_writes[file_path] = data

    def flush(self) -> None:
        self.flushed = True

    def shutdown(self) -> None:
        self.shutdown_called = True


@pytest.fixture()
def tier_config(tmp_path: Path) -> Path:
    config = {
        "bundles": [
            {
                "id": "tier1-core",
                "label": "Core Tier1",
                "trigger": {"type": "always"},
                "entries": [
                    {"type": "path", "base": "rp", "value": "entities/Aurora.md"}
                ],
            },
            {
                "id": "tier2-arc",
                "label": "Arc",
                "trigger": {"type": "every_n_responses", "interval": 2},
                "entries": [
                    {"type": "path", "base": "rp", "value": "state/story_arc.md"}
                ],
            },
            {
                "id": "tier3-triggered",
                "label": "Triggered",
                "trigger": {"type": "triggered"},
                "entries": [
                    {"type": "triggered_paths"}
                ],
            },
        ]
    }
    config_path = tmp_path / "tiered_bundles.json"
    config_path.write_text(json.dumps(config, indent=2), encoding="utf-8")
    return config_path


def test_build_file_access_service_loads_tiered_content(tmp_path: Path, tier_config: Path) -> None:
    rp_dir = tmp_path / "rp"
    state_dir = rp_dir / "state"
    entities_dir = rp_dir / "entities"
    state_dir.mkdir(parents=True)
    entities_dir.mkdir(parents=True)

    (entities_dir / "Aurora.md").write_text(
        "Aurora Profile\nPersonality Core: Empathy\n",
        encoding="utf-8",
    )
    (state_dir / "story_arc.md").write_text("Arc content", encoding="utf-8")

    triggered_file = state_dir / "alerts" / "artifact.md"
    triggered_file.parent.mkdir(parents=True)
    triggered_file.write_text("Triggered artifact", encoding="utf-8")

    logger = StubLogger()
    queue = FileWriteQueue(queue=StubQueue(), logger=logger)

    service = build_file_access_service(
        rp_dir=rp_dir,
        logger=logger,
        tier_config_path=tier_config,
        write_queue=queue,
    )

    # Counter increments start at 1
    assert service.increment_response_counter() == 1

    tiered = service.load_tiered_context(response_count=2, triggered_files=[triggered_file])

    assert "tier1-core" in tiered.tier1
    tier1_bundle = tiered.tier1["tier1-core"]
    assert tier1_bundle.files["entities/Aurora.md"].startswith("Aurora Profile")
    assert tier1_bundle.metadata["entities_with_cores"] == ["Aurora"]

    assert "tier2-arc" in tiered.tier2
    tier2_bundle = tiered.tier2["tier2-arc"]
    assert tier2_bundle.files["state/story_arc.md"] == "Arc content"

    assert "tier3-triggered" in tiered.tier3
    tier3_bundle = tiered.tier3["tier3-triggered"]
    assert "state/alerts/artifact.md" in tier3_bundle.files
    assert tier3_bundle.files["state/alerts/artifact.md"] == "Triggered artifact"
